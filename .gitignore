/private/conf/users.htpasswd
/private/cache/auth/
/private/conf/accounts/

# Local secrets and credential backups
.env
.env.*
!.env.example
*.htpasswd
*.htpasswd.*

# Personal server stack and local backups (may contain credentials)
/docker-compose.yml
/docker-compose.yml.*.bak

# Runtime caches may contain previews of private documents
/private/cache/*
!/private/cache/README.md
/public/cache/*
!/public/cache/README.md
